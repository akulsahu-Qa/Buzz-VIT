# Buzz relay URL (WebSocket for client, HTTP for API)
BUZZ_RELAY_HTTP_URL=https://vitoperationsdemo.communities.buzz.xyz

# Bot keypair — generate with: buzz-admin generate-key --name workflow-bot
# NEVER commit the actual private key to git
BOT_PRIVATE_KEY=your_bot_private_key_hex_here

# Channel IDs — find these in Buzz after creating the channels
# Right-click a channel > Channel Info > copy the ID
NURSES_CHANNEL_ID=your_nurses_channel_id_here
SUPERVISORS_CHANNEL_ID=your_supervisors_channel_id_here
HOSPITAL_ALERTS_CHANNEL_ID=your_hospital_alerts_channel_id_here
PATIENT_EXPERIENCE_CHANNEL_ID=your_patient_experience_channel_id_here

# Base URL of the frontend checklist app
CHECKLIST_BASE_URL=http://localhost:5173

# Admin Security Key
ADMIN_API_KEY=supersecret123

# Database URL (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///./hospital.db

# Backend Base URL (used for photo uploads)
API_BASE_URL=http://localhost:8000
